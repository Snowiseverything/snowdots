#!/usr/bin/env python3
"""Govee BLE fast-daemon — holds one persistent BLE connection open.

Minimal socket server at /tmp/govee-fast.sock.
Accepts newline-delimited commands:
  RRGGBB BRIGHTNESS     — set color immediately
  fade RRGGBB BRIGHT    — smooth fade (10-step ease-in-out)

Systemd unit: ~/.config/systemd/user/govee-fast.service
"""

import asyncio, os, sys

GOVEE_ADDR = "C6:32:38:31:2F:48"
SOCKET_PATH = "/tmp/govee-fast.sock"

# ── Config ────────────────────────────────────────────────────────────────
import sys as _sys
from pathlib import Path as _Path
_sys.path.insert(0, str(_Path.home() / ".local/bin"))
try:
    from rgb_config import load_config, config_value
    _C = load_config()
    _s = config_value(_C, "govee", "daemon_socket")
    if _s:
        SOCKET_PATH = _s
except Exception:
    pass

WRITE_CHAR = "00010203-0405-0607-0809-0a0b0c0d2b11"
FADE_STEPS = 10
FADE_DELAY = 0.020
KEEPALIVE_S = 5


def _crc(data: bytes) -> int:
    c = 0
    for b in data: c ^= b
    return c

def _pkt(r: int, g: int, b: int) -> bytes:
    """Build Govee color packet — must be exactly 20 bytes."""
    data = bytearray([0x33, 0x05, 0x15, 0x01, r, g, b,
                       0, 0, 0, 0, 0, 0xFF, 0x7F])
    data += b'\x00' * (19 - len(data))  # pad to 19
    chk = 0
    for x in data:
        chk ^= x
    data.append(chk)
    return bytes(data)

def _ease(t): return t * t * (3 - 2 * t)


async def handle(client, reader, writer, color_state):
    lr, lg, lb = color_state[0], color_state[1], color_state[2]
    try:
        while True:
            line = await reader.readline()
            if not line: break
            parts = line.decode().strip().split()
            if not parts: continue
            try:
                if parts[0] == "fade":
                    tr = int(parts[1][0:2], 16); tg = int(parts[1][2:4], 16); tb = int(parts[1][4:6], 16)
                    for i in range(1, FADE_STEPS + 1):
                        t = _ease(i / FADE_STEPS)
                        cr = int(lr + (tr - lr) * t)
                        cg = int(lg + (tg - lg) * t)
                        cb = int(lb + (tb - lb) * t)
                        await client.write_gatt_char(WRITE_CHAR, _pkt(cr, cg, cb), response=False)
                        await asyncio.sleep(FADE_DELAY)
                    lr, lg, lb = tr, tg, tb
                    color_state[0], color_state[1], color_state[2] = tr, tg, tb
                else:
                    lr = int(parts[0][0:2], 16); lg = int(parts[0][2:4], 16); lb = int(parts[0][4:6], 16)
                    color_state[0], color_state[1], color_state[2] = lr, lg, lb
                    await client.write_gatt_char(WRITE_CHAR, _pkt(lr, lg, lb), response=False)
                writer.write(b"ok\n"); await writer.drain()
            except Exception as e:
                writer.write(f"error {e}\n".encode()); await writer.drain()
    except Exception:
        pass
    finally:
        writer.close()


async def main():
    from bleak import BleakClient
    if os.path.exists(SOCKET_PATH): os.unlink(SOCKET_PATH)

    def load_last_color() -> list[int]:
        """Restore last dimmed RGB from govee-led.py's state file.

        govee-fast starts with color_state [0,0,0] — its 5s keepalive would
        write a black packet (RGB 0 = off) and turn the strip OFF at boot
        before any real color arrives. Seed from /tmp/govee-last-color so
        the first keepalive restores the last color instead of killing it.
        """
        try:
            parts = open("/tmp/govee-last-color").read().strip().split()
            if len(parts) == 3:
                return [int(x) for x in parts]
        except (OSError, ValueError):
            pass
        return [0, 0, 0]

    # Start socket immediately (clients see "error" while BLE connects)
    async def on_connect(r, w):
        await handle(ble_client, r, w, color_state) if ble_client else (
            w.write(b"error BLE down\n"), await w.drain(), w.close())

    ble_client = None
    color_state = load_last_color()
    server = await asyncio.start_unix_server(on_connect, SOCKET_PATH)
    print(f"Socket ready on {SOCKET_PATH}", file=sys.stderr)

    while True:
        try:
            print(f"Connecting to Govee {GOVEE_ADDR}...", file=sys.stderr)
            async with BleakClient(GOVEE_ADDR, timeout=15) as c:
                ble_client = c
                print("Govee BLE connected", file=sys.stderr)
                # Govee H6102 drops the BLE link within ~3-5s unless you
                # subscribe to the write characteristic's notifications.
                # Subscribe immediately to hold the connection; without it
                # the link flaps and every reconnect writes stale state.
                try:
                    await c.start_notify(WRITE_CHAR, lambda s, d: None)
                except Exception as e:
                    print(f"notify subscribe failed: {e}", file=sys.stderr)
                # Re-read last color: govee-led.py may have written one via
                # the HA fallback while BLE was down — sync the keepalive
                # to it so we don't write a stale/black packet.
                if color_state == [0, 0, 0]:
                    color_state[:] = load_last_color()
                while c.is_connected:
                    await asyncio.sleep(KEEPALIVE_S)
                    if c.is_connected:
                        # Never keepalive black — RGB(0,0,0) is power-off on
                        # Govee. Off stays off; a real color comes via socket.
                        if color_state == [0, 0, 0]:
                            continue
                        try: await c.write_gatt_char(WRITE_CHAR, _pkt(color_state[0], color_state[1], color_state[2]), response=False)
                        except Exception: break
                print("Disconnected, reconnecting...", file=sys.stderr)
        except Exception as e:
            print(f"BLE error: {e}, retrying in 2s...", file=sys.stderr)
        finally:
            ble_client = None
            await asyncio.sleep(2)


if __name__ == "__main__":
    asyncio.run(main())
